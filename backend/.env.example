# Environment Variables for UstadJi Backend
PORT=4000

# PostgreSQL Connection String
# Local format: postgresql://<user>:<password>@localhost:5432/<dbname>?schema=public
# Cloud format (Neon / Supabase / Render / Railway): postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ustadji?schema=public"

# Auth Secrets
JWT_SECRET="ustadji-super-secret-jwt-key-2026"
JWT_EXPIRATION="7d"

# Redis URL (Optional - defaults to in-memory lock manager & timer if not available)
REDIS_URL="redis://localhost:6379"

# Node Environment
NODE_ENV="development"
