{
  "name": "ustadji-backend",
  "version": "1.0.0",
  "description": "UstadJi Core NestJS Backend with Module 5 Booking & Scheduling",
  "author": "UstadJi Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "ts-node src/main.ts",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:status": "ts-node prisma/db-status.ts",
    "prisma:export": "ts-node prisma/export-data.ts",
    "prisma:import": "ts-node prisma/import-data.ts",
    "test:agent": "ts-node --project tsconfig.json test/agent.integration-check.ts",
    "test:agent:understanding": "ts-node --project tsconfig.json test/agent-understanding-check.ts",
    "test:agent:understanding:live": "ts-node --project tsconfig.json test/agent-understanding-live.ts",
    "test:agent:live": "ts-node --project tsconfig.json test/agent.integration-check.ts --live",
    "agent:fixture": "ts-node --project tsconfig.json test/agent.integration-check.ts --serve"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.41.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "date-fns": "^3.6.0",
    "ioredis": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
