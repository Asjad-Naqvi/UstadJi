datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  phone            String?           @unique
  password         String
  fullName         String
  role             String            @default("CUSTOMER") // CUSTOMER, PROVIDER, ADMIN
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  customerProfile  CustomerProfile?
  providerProfile  ProviderProfile?
  customerBookings Booking[]         @relation("CustomerBookings")
  providerBookings Booking[]         @relation("ProviderBookings")
  notifications    NotificationLog[]
}

model CustomerProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address    String?
  sector     String?  @default("F-7/2")
  city       String   @default("Islamabad")
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ProviderProfile {
  id                String         @id @default(uuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade             String         // "Master Plumber", "HVAC & AC Expert", "Electrician"
  experienceYears   Int            @default(5)
  hourlyRate        Float          @default(800.0)
  rating            Float          @default(4.9)
  reviewCount       Int            @default(45)
  sectorsCovered    String         @default("F-7,F-8,G-11,Islamabad")
  isVerified        Boolean        @default(true)
  bookingPreference String         @default("MANUAL_APPROVAL") // AUTO_CONFIRM, MANUAL_APPROVAL
  bufferMinutes     Int            @default(30) // Buffer gap between jobs
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workingHours      WorkingHours[]
}

model WorkingHours {
  id           String          @id @default(uuid())
  providerId   String
  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  dayOfWeek    Int             // 0=Sunday, 1=Monday, 2=Tuesday, 3=Wednesday, 4=Thursday, 5=Friday, 6=Saturday
  startTime    String          @default("09:00") // HH:mm
  endTime      String          @default("18:00") // HH:mm
  isWorkingDay Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([providerId, dayOfWeek])
}

model Booking {
  id                 String                 @id @default(uuid())
  bookingCode        String                 @unique // e.g. "BK-1001"
  customerId         String
  customer           User                   @relation("CustomerBookings", fields: [customerId], references: [id])
  providerId         String
  provider           User                   @relation("ProviderBookings", fields: [providerId], references: [id])
  serviceCategory    String                 // "Plumbing", "AC Repair", "Electrical"
  issueDescription   String
  appointmentDate    DateTime               // Date (YYYY-MM-DD)
  startTime          String                 // "10:00"
  endTime            String                 // "11:00"
  estimatedPrice     Float                  @default(800.0)
  status             String                 @default("PENDING_ACCEPTANCE")
  // Statuses: PENDING_ACCEPTANCE, SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED, EXPIRED, REJECTED
  
  acceptanceDeadline DateTime?              // 30-min timer for manual approval
  lockKey            String?                // Redis slot lock key
  rescheduledFromId  String?                // If this is a reschedule of another booking
  rescheduleReason   String?
  cancellationReason String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  statusHistory      BookingStatusHistory[]
  notifications      NotificationLog[]
}

model BookingStatusHistory {
  id         String   @id @default(uuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String   // "CUSTOMER", "PROVIDER", "SYSTEM", "ADMIN"
  note       String?
  createdAt  DateTime @default(now())
}

model NotificationLog {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  title       String
  body        String
  channel     String   @default("EXPO_PUSH")
  type        String   // "NEW_BOOKING_REQUEST", "BOOKING_CONFIRMED", "REQUEST_EXPIRED", "REMINDER", "RESCHEDULED"
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}
